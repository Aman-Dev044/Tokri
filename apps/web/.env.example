# ─────────────────────────────────────────────────────────────────────────────
#  apps/web/.env.example — COMMITTED. Every value is EMPTY on purpose.
#  Copy to .env.local and fill it in. .env.local is gitignored and must
#  never be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public ───────────────────────────────────────────────────────────────────
# Anything prefixed NEXT_PUBLIC_ is bundled into client JS and is readable by
# anyone who opens devtools. ONLY put values here that are safe to publish.
#
# There are NO fallbacks for these anywhere in the codebase. If one is missing,
# the build fails loudly rather than booting half-configured (plan §4.1).

NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SOCKET_URL=

# key_id is public by design. key_secret is NOT and lives only in the API.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Must be HTTP-referrer restricted AND API restricted in the GCP console.
# The unrestricted server key never leaves the API.
NEXT_PUBLIC_MAPS_BROWSER_KEY=

NEXT_PUBLIC_SENTRY_DSN=

# Absolute origin of this app. Used for canonical URLs, OG images and sitemap.
NEXT_PUBLIC_SITE_URL=

# ── Server-only ──────────────────────────────────────────────────────────────
# Never prefixed NEXT_PUBLIC_. May only be read inside a Server Component, a
# Route Handler or middleware.ts. Next will throw at build time if one of
# these is referenced from a client component — treat that error as correct.

REVALIDATE_TOKEN=
