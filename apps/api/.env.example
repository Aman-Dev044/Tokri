####################################################################
#  MANDI API — ENVIRONMENT TEMPLATE
#
#  Copy to `.env` and fill in. NEVER commit `.env`.
#
#  RULE: every value below is read through ConfigService only.
#  There is NO hardcoded fallback anywhere in the codebase.
#  A missing REQUIRED value means the process refuses to boot.
####################################################################

# ── Runtime ───────────────────────────────────────────────────────
NODE_ENV=
PORT=
API_PREFIX=
ORDER_NO_PREFIX=

# ── CORS (comma-separated origin allowlist — NEVER "*") ───────────
CORS_ORIGINS=
CORS_CREDENTIALS=

# ── Cookies ───────────────────────────────────────────────────────
COOKIE_DOMAIN=
COOKIE_SECURE=

# ── Database ──────────────────────────────────────────────────────
MONGO_URI=
MONGO_DB_NAME=

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=

# ── Auth secrets (min 32 chars each, unique per environment) ──────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=
JWT_REFRESH_TTL=
ARGON2_PEPPER=

# ── Rate limiting ─────────────────────────────────────────────────
THROTTLE_TTL_MS=
THROTTLE_LIMIT=
THROTTLE_AUTH_LIMIT=

# ── Seed accounts (used ONCE by `pnpm seed`) ──────────────────────
SEED_SUPERADMIN_NAME=
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PHONE=
SEED_SUPERADMIN_PASSWORD=

SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=

# Shared password for demo accounts (pnpm seed:demo). Optional: the API
# boots without it; only the demo seeder requires it. Min 12 characters.
SEED_DEMO_PASSWORD=

# ── Razorpay (optional — online payment only; COD works without it) ─
# The API boots fine with these blank: POST /checkout with
# paymentMethod:'online' returns 503 and POST /webhooks/razorpay
# returns 401 until all three are set. See env.validation.ts.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

####################################################################
#  Added in later phases — not required to boot today.
#  Uncomment in env.validation.ts as each phase lands.
####################################################################
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# GOOGLE_MAPS_SERVER_KEY=
# SENDGRID_API_KEY=
# MAIL_FROM=
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=
# FCM_SERVICE_ACCOUNT_JSON=
# SENTRY_DSN=

# ── Rider wallet & KYC ────────────────────────────────────────────
# A rider pays a fee, drawn at RANDOM per order in [MIN, MAX], to
# accept an offer. INTEGER PAISE: 2500 is ₹25. MAX must be >= MIN or
# the API refuses to boot.
RIDER_PICK_FEE_MIN_PAISE=2500
RIDER_PICK_FEE_MAX_PAISE=5000
# Warn (socket + notification) at or below this balance. ₹100.
RIDER_LOW_BALANCE_WARN_PAISE=10000
# The promise on the rider's KYC screen: verified within this many hours.
RIDER_KYC_SLA_HOURS=24
